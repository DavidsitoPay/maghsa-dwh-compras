{
  "_comentario": "Input para 'aws glue create-crawler'. Crawler on demand (sin Schedule): se ejecuta manualmente con 'aws glue start-crawler'. Sustituir <bucket-maghsa-dwh> y <account-id> antes de ejecutar. El rol AWSGlueServiceRole-MAGHSA usa la politica administrada AWSGlueServiceRole mas lectura (s3:GetObject, s3:ListBucket) sobre analytics/.",
  "Name": "crawler-maghsa-compras-analytics",
  "Role": "arn:aws:iam::<account-id>:role/AWSGlueServiceRole-MAGHSA",
  "DatabaseName": "compras_dwh",
  "Description": "Crawler sobre la zona analytics/ del data lake de compras de MAGHSA",
  "Targets": {
    "S3Targets": [
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/hechos_compras/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_proveedor/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_producto/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_categoria/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_tiempo/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_categoria_proveedor/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_unidad_organizacional/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/dim_contacto_proveedor/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/puente_proveedor_categoria_proveedor/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/puente_proveedor_categoria_producto/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/puente_proveedor_producto/" },
      { "Path": "s3://<bucket-maghsa-dwh>/analytics/categoria_proveedor_x_categoria_producto/" }
    ]
  },
  "SchemaChangePolicy": {
    "UpdateBehavior": "UPDATE_IN_DATABASE",
    "DeleteBehavior": "LOG"
  },
  "RecrawlPolicy": {
    "RecrawlBehavior": "CRAWL_EVERYTHING"
  }
}
