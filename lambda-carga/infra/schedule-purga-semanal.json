{
  "Name": "maghsa-purga-semanal",
  "Description": "Purga semanal de runs antiguos (T8). Creado apagado; lo enciende el usuario.",
  "State": "DISABLED",
  "ScheduleExpression": "cron(0 3 ? * SUN *)",
  "ScheduleExpressionTimezone": "America/Guatemala",
  "FlexibleTimeWindow": {
    "Mode": "OFF"
  },
  "Target": {
    "Arn": "arn:aws:lambda:us-east-1:<account-id>:function:maghsa-purga-runs",
    "RoleArn": "arn:aws:iam::<account-id>:role/maghsa-scheduler-lambda-role",
    "Input": "{}",
    "RetryPolicy": {
      "MaximumRetryAttempts": 0,
      "MaximumEventAgeInSeconds": 60
    }
  }
}
